{#
/**
 * @file
 * Bloque "Texto e imagen": texto e imagen en dos columnas.
 *
 * Las variables `img_url`, `img_alt` y `posicion_imagen` se calculan en
 * lucia_front_preprocess_block__block_content__type__texto_e_imagen()
 * dentro de lucia_front.theme.
 *
 * `posicion_imagen` puede ser 'derecha', 'izquierda' o 'centrada' (valor del
 * campo field_posicion_imagen) y controla la disposición del bloque mediante
 * la clase modificadora `texto-imagen-block--imagen-{{ posicion_imagen }}`.
 * Con 'centrada', el texto se muestra arriba y la imagen debajo, centrada.
 */
#}

{% if posicion_imagen != 'fondo' %}
  <section{{ attributes.addClass('texto-imagen-block', 'texto-imagen-block--imagen-' ~ posicion_imagen) }}>
    <div class="texto-imagen-block__content">
      <div class="texto-imagen-block__titulo">
        {{ content.field_titulo }}
      </div>
      <div class="texto-imagen-block__text">
        {{ content.field_descripcion }}
      </div>
      <div class="texto-imagen-block__cta">
        {{ content.field_cta }}
      </div>
    </div>
    <div class="texto-imagen-block__image">
      {% if img_url %}
        <img src="{{ img_url }}" alt="{{ img_alt }}" loading="lazy" />
      {% endif %}
    </div>
  </section>
{% else %}
  <section{{ attributes.addClass(posicion_imagen) }}>
    <div class="texto-imagen-block__text_imagen_fondo"{% if img_url %}{% endif %}>
       {{ content.field_descripcion }}
   </div>
   
  </section>
{% endif %}