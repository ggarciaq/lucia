{#
/**
 * @file
 * Theme override to display page for node 2.
 */
#}
{% set svg_bars %}
{% include '@solo/partials/svg/_svg-bars.html.twig' %}
{% endset %}
{% set svg_search %}
{% include '@solo/partials/svg/_svg-search.html.twig' %}
{% endset %}

<!-- Start: Page Wrapper -->
{% set page_wrapper_classes = 'page-wrapper' ~
  ' mis-historia-fondo' ~
  (site_width_class ? ' ' ~ site_width_class) ~
  (site_global_breakpoints ? ' ' ~ site_global_breakpoints) ~
  (site_menu_breakpoints ? ' ' ~ site_menu_breakpoints) ~
  (site_pagetitle_google_font ? ' ' ~ site_pagetitle_google_font) ~
  (site_pagetitle_animate_on ? ' ' ~ site_pagetitle_animate_on) ~
  (site_pagetitle_center ? ' ' ~ site_pagetitle_center) ~
  (title_size_l ? ' ' ~ title_size_l) ~
  (title_size_s ? ' ' ~ title_size_s) ~
  (classes_page_wrapper ? ' ' ~ classes_page_wrapper) ~
  (opacity_page_wrapper ? ' solo__fade-in' : '') ~
  (site_breadcrumb_scroll ? ' solo__bc-scroll' : '') ~
  (site_regions_collapse_order ? ' solo__collapse-order' : '') ~
  (site_flip_header_menu ? ' menu-flipped' : '') ~
  (site_inline_items_on ? ' solo__inline-items' : '') ~
  ' page--node-2'
%}

<div id="page-wrapper" class="{{ page_wrapper_classes }}" {{ attributes_page_wrapper }}>

  {% if site_regions_highlighted_disable == 0 %}
  {% include '@solo/partials/_highlighted.html.twig' %}
  {% endif %}
  {% if site_regions_highlighted_disable == 1 and is_front %}
  {% include '@solo/partials/_highlighted.html.twig' %}
  {% endif %}
  {% if site_regions_highlighted_disable == 2 and not is_front %}
  {% include '@solo/partials/_highlighted.html.twig' %}
  {% endif %}

  {% include '@solo/partials/_primary-sidebar-menu.html.twig' %}

  {% include '@solo/partials/_fixed-search-block.html.twig' %}

  {% include '@solo/partials/_popup-login-block.html.twig' %}

  {% if site_flip_header_menu %}
  {% include '@solo/partials/_primary-menu.html.twig' %}
  {% include '@solo/partials/_header.html.twig' %}
  {% else %}
  {% include '@solo/partials/_header.html.twig' %}
  {% include '@solo/partials/_primary-menu.html.twig' %}
  {% endif %}

  {% if site_regions_welcome_disable == 0 %}
  {% include '@solo/partials/_welcome-text.html.twig' %}
  {% endif %}
  {% if site_regions_welcome_disable == 1 and is_front %}
  {% include '@solo/partials/_welcome-text.html.twig' %}
  {% endif %}
  {% if site_regions_welcome_disable == 2 and not is_front %}
  {% include '@solo/partials/_welcome-text.html.twig' %}
  {% endif %}

  {% if site_regions_top_disable == 0 %}
  {% include '@solo/partials/_top-regions.html.twig' %}
  {% endif %}
  {% if site_regions_top_disable == 1 and is_front %}
  {% include '@solo/partials/_top-regions.html.twig' %}
  {% endif %}
  {% if site_regions_top_disable == 2 and not is_front %}
  {% include '@solo/partials/_top-regions.html.twig' %}
  {% endif %}

  {% include '@solo/partials/_system-messages.html.twig' %}

  {% include '@solo/partials/_page-title.html.twig' %}

  {% include '@solo/partials/_breadcrumb.html.twig' %}

  {% include '@solo/partials/_main-regions.html.twig' %}

  {% if site_regions_bottom_disable == 0 %}
  {% include '@solo/partials/_bottom-regions.html.twig' %}
  {% endif %}
  {% if site_regions_bottom_disable == 1 and is_front %}
  {% include '@solo/partials/_bottom-regions.html.twig' %}
  {% endif %}
  {% if site_regions_bottom_disable == 2 and not is_front %}
  {% include '@solo/partials/_bottom-regions.html.twig' %}
  {% endif %}

  {% if site_regions_footer_disable == 0 %}
  {% include '@solo/partials/_footer-regions.html.twig' %}
  {% endif %}
  {% if site_regions_footer_disable == 1 and is_front %}
  {% include '@solo/partials/_footer-regions.html.twig' %}
  {% endif %}
  {% if site_regions_footer_disable == 2 and not is_front %}
  {% include '@solo/partials/_footer-regions.html.twig' %}
  {% endif %}

  {% include '@solo/partials/_footer-menu.html.twig' %}

  {% include '@solo/partials/_copyright.html.twig' %}
</div>
<!-- End: Page Wrapper -->
